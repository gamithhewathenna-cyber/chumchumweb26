# Images uploaded from the admin panel. Never run scripts from this folder.
Options -Indexes -ExecCGI
<FilesMatch "\.(?i:php[0-9]?|phtml|phar|pht|pl|py|cgi|sh|shtml|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
