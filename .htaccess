# Chum Chum's — site-wide Apache rules
Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always use https://www.chumchums.com.au (only applies on the live domain)
  RewriteCond %{HTTP_HOST} ^chumchums\.com\.au$ [NC]
  RewriteRule ^ https://www.chumchums.com.au%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.chumchums\.com\.au$ [NC]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://www.chumchums.com.au%{REQUEST_URI} [L,R=301]

  # Tell PHP that clean addresses work here, so the site links to "/about", not "/about.php"
  RewriteRule ^ - [E=CLEAN_URLS:1]

  # Sitemap for search engines, built live by sitemap.php
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # ---------- Clean, search-friendly addresses ----------
  # Old addresses move permanently (301) so Google keeps one URL per page:
  #   /index.php → /      /about.php → /about      /contact.php?sent=1 → /contact?sent=1
  # (Only links typed or followed by visitors — form posts and admin pages are left alone.)
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{REQUEST_METHOD} !=POST
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+index(\.php)?[\s?] [NC]
  RewriteRule ^index(\.php)?$ / [R=301,L,NC]

  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{REQUEST_METHOD} !=POST
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s/+([a-z0-9-]+)\.php[\s?] [NC]
  RewriteCond %1 !^sitemap$ [NC]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^([a-z0-9-]+)\.php$ /%1 [R=301,L,NC]

  # "/about/" → "/about"
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.php -f
  RewriteRule ^([a-z0-9-]+)/$ /$1 [R=301,L,NC]

  # Serve "/about" from about.php (the address bar keeps showing "/about")
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([a-z0-9-]+)$ $1.php [L,NC]

  # Hidden folders and files (.git, .env …) — but keep .well-known for SSL certificates
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # Private folders (each also has its own .htaccess)
  RewriteRule ^(config|database|admin/includes)(/|$) - [F,L]
</IfModule>

# Never serve source, dump or hidden files
<FilesMatch "(^\.|\.(sql|md|log|ini|bak|sh|example\.php)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ---------- Security headers ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Remember to use HTTPS (only sent over HTTPS)
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header unset X-Powered-By
</IfModule>

# ---------- Speed: compress text files ----------
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
  </IfModule>
</IfModule>

# ---------- Speed: let browsers keep files (CSS/JS/images carry a ?v= version, so changes still show at once) ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
</IfModule>
